# Godot 4+ specific ignores
.godot/
/android/

# (you add below this)
.import/
export.cfg
export_presets.cfg
*.tmp
*.import
__pycache__/

# Headless harness output. Every .json under headless/ is written by a script
# that lives beside it, so it is regenerable and only ever shows up as noise in
# a diff when a harness is re-run. Add an exception here if a hand-authored
# fixture ever needs to live in that folder.
headless/*.json

# Export/build output and capture scratch — all regenerable from an export
# preset or a recording session, all root-level, and together ~290 MB. Anchored
# with a leading slash so only the real build directories match, not a
# same-named folder somewhere inside the project.
/42_web_itch.zip
/itch_web/
/42_windows_itch.zip
/itch_windows/
/android_test/
/recordings/
